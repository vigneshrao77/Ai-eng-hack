# ModernRx Configuration Template

# Server & Mode
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
STANDALONE_LOCAL_MODE=true
OFFLINE_DEMO_MODE=true

# LLM (Anthropic)
# Pinned model: claude-3-5-sonnet-20241022 or claude-sonnet-5-5
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
LLM_SEND_RAW_CODE=false

# Datastores
# PostgreSQL (Default prod) or SQLite (Default standalone local: sqlite:///./data/modernrx.db)
DATABASE_URL=sqlite:///./data/modernrx.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/modernrx

# Neo4j Knowledge Graph (Optional in local mode; in-memory NetworkX store used if unavailable)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=modernrx_secret
USE_NEO4J=false

# Redis & Celery (Optional in local mode; in-memory task runner used if unavailable)
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false

# Object Storage (MinIO / S3; fallback to local data/storage if unavailable)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=modernrx-artifacts
USE_S3=false

# Authentication & Security
JWT_SECRET=modernrx-super-secure-jwt-signing-secret-key-32chars
JWT_EXPIRE_MINUTES=480

# ModernRx Engine Hyperparameters
DECOMP_WEIGHTS=0.30,0.20,0.25,0.10,0.15
DECOMP_GAMMA=1.5
HDBSCAN_MIN_CLUSTER_SIZE=4
MONTECARLO_RUNS=10000
GXP_MULTIPLIER_HIGH=1.8
GXP_MULTIPLIER_MEDIUM=1.3
